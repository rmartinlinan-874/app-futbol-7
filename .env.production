# Configuración pública de Firebase para la versión publicada en GitHub Pages.
#
# Estos valores NO son secretos: Firebase los diseña para ir dentro del
# código que descarga cualquier navegador (ya están, por ejemplo, en
# public/sw.js y en la app publicada). La seguridad la ponen las reglas de
# Firestore (firestore.rules), no estas claves. Por eso pueden ir en el
# repositorio y así la publicación automática (.github/workflows/publicar.yml)
# no necesita que nadie copie nada a mano.
#
# Para desarrollar en local con otros valores, crea un ".env.local" (que no se
# sube a GitHub): tiene prioridad sobre este archivo.
VITE_FIREBASE_API_KEY=AIzaSyCQzYSnw5CDmYWG20ceNi7kn4GOsH40rLQ
VITE_FIREBASE_AUTH_DOMAIN=app-futbol-7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=app-futbol-7
VITE_FIREBASE_STORAGE_BUCKET=app-futbol-7.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=763169874663
VITE_FIREBASE_APP_ID=1:763169874663:web:35d64889432f304717b842
VITE_FIREBASE_VAPID_KEY=BD1kWQ3Z78B04JqOSNQNaigYzL2B00stzZGwylir8luofA8AAFIFniA97YbzbSBbXgPnTGsOw4C5uKEebzdb8Iw
VITE_BASE_PATH=/app-futbol-7/
