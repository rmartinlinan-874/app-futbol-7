# Copia este archivo a ".env" y rellena con los datos de tu proyecto Firebase
# (Firebase console -> Configuración del proyecto -> Tus apps -> SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ruta base para GitHub Pages: '/nombre-del-repo/'. Déjalo en '/' si usas un dominio propio.
VITE_BASE_PATH=/app-pena/

# Para desarrollar sin un proyecto Firebase real, usando los emuladores locales
# (npm run emuladores): pon esto a "true" y deja lo anterior vacío.
VITE_USE_EMULATOR=false

# Clave VAPID para notificaciones push (Firebase console -> Configuración del
# proyecto -> Cloud Messaging -> Certificados push web -> Generar par de claves).
VITE_FIREBASE_VAPID_KEY=

